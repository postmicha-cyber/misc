# SonnenPilot – Kopie als .env speichern und ausfüllen. Die .env NIE ins Git hochladen (steht in .gitignore).

# Growatt-Zugang (derselbe wie in der ShinePhone-App)
GROWATT_USER=
GROWATT_PASSWORD=
# Alternativ statt Klartext: Growatt-Hash des Passworts (node -e "console.log(require('./growatt').hashPassword('DEIN_PASSWORT'))")
# GROWATT_PASSWORD_HASH=
# Seriennummer des NOAH – leer lassen, dann wird sie im Konto gesucht
GROWATT_SN=
# Nur ändern, wenn dein Konto auf einem anderen Growatt-Server liegt
# GROWATT_SERVER=https://server-api.growatt.com

# Zugangsschlüssel für die Handy-App (leer = wird beim ersten Start erzeugt und im Protokoll angezeigt)
APP_KEY=

# Port der App im Heimnetz
PORT=8787
# Wie oft geregelt wird (Sekunden, mindestens 60). Standard: 300, mit Stromzähler 120
# TICK_SECONDS=300

# Zum Ausprobieren ohne Growatt: SIMULATE=1
# SIMULATE=1
